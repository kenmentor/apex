MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
SENDINBLUE_API_KEY=your_sendinblue_api_key
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Theory System — OpenRouter (LLM-powered grading)
# Get your key at https://openrouter.ai/keys
# If not set, keyword scoring still works (no LLM grading)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemini-2.5-flash-image

# Google Sign-In (https://console.cloud.google.com/apis/credentials)
# Without these, the Google button stays hidden and email auth works alone.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public base URL used in verification links
FRONTEND_URL=http://localhost:3000

# Mock email-code verification (any 4+ char code works). Set to false to enforce real links only.
ALLOW_ANY_CODE=true
